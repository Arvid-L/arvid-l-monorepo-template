DATABASE_HOST=localhost
DATABASE_NAME=arvid-l-monorepo-template-db-test
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_PORT=5433

# Auth
JWT_SECRET=local-e2e-secret-do-not-use-in-prod

# The Cypress suite logs in far more often per minute than the strict
# credential throttle (5/min per IP) allows — raise it for e2e only.
THROTTLE_CREDENTIAL_LIMIT=100

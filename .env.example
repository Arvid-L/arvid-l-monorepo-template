# Local development reference.
# .env.dev (NODE_ENV=development) and .env.e2e (NODE_ENV=e2e) are committed
# with these non-secret localhost defaults and work out of the box with
# `docker compose up` (dev DB on 5432, e2e DB on 5433).
# For production configuration see .env.production.example.

DATABASE_HOST=localhost
DATABASE_NAME=arvid-l-monorepo-template-db
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_PORT=5432

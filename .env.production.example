# Production environment — copy to .env.production and fill in real values.
# .env.production is gitignored and gets scp'd to the server by
# scripts/deploy-remote.sh. It is used both for docker compose variable
# interpolation (--env-file .env.production) and as container environment.

# Project identity (rewritten by the init-project script)
PROJECT_NAME=arvid-l-monorepo-template
ENV_NAME=prod

# Public domain — DNS A record must point at the server before running init-tls.sh
DOMAIN=example.org
LETSENCRYPT_EMAIL=you@example.org

# Allowed CORS origins (comma-separated). The frontend is served same-origin
# through nginx, so this only matters for external API consumers.
CORS_ORIGIN=https://example.org

# Database credentials (DB is only reachable from the compose network + loopback)
DATABASE_NAME=app
DATABASE_USER=app
DATABASE_PASSWORD=change-me

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-long-random-string

# Public base URL of the frontend — used in links inside outgoing mails
# (password reset). Should match https://<DOMAIN>.
APP_BASE_URL=https://example.org

# Outgoing mail (verification, password reset). All optional: without
# SMTP_HOST mails are only logged, not delivered.
# Hetzner webhosting mail (comes with domains bought at Hetzner): create a
# mailbox like noreply@<your-domain> in konsoleH → Email, then:
#   SMTP_HOST=mail.your-server.de   SMTP_PORT=587   SMTP_SECURE=false
#   SMTP_USER=<the full mailbox address>   SMTP_PASSWORD=<mailbox password>
#   MAIL_FROM=<the full mailbox address>
# Any transactional provider (Brevo, Resend, Mailgun, ...) works the same way.
# Verify with: npm run mail:test -- you@somewhere.com
#SMTP_HOST=mail.your-server.de
#SMTP_PORT=587
#SMTP_USER=noreply@example.org
#SMTP_PASSWORD=change-me
# 'true' only for implicit TLS on port 465; 587 uses STARTTLS automatically
#SMTP_SECURE=false
#MAIL_FROM=noreply@example.org

# TLS state — managed by scripts/init-tls.sh, leave these defaults on a fresh
# setup (HTTP-only). init-tls.sh switches them to templates-tls + tls.
NGINX_TEMPLATES=templates-http
COMPOSE_PROFILES=

# Deploy target for scripts/deploy-remote.sh (host may be a ~/.ssh/config alias)
DEPLOY_HOST=my-server
DEPLOY_USER=root
DEPLOY_PATH=/opt/arvid-l-monorepo-template

# DB backups (scripts/backup-db.sh, install as cron — see docs/HETZNER-SETUP.md)
#BACKUP_DIR=/var/backups/arvid-l-monorepo-template
#BACKUP_KEEP_DAYS=14
# Optional off-site push per backup, any rsync/scp target:
#BACKUP_REMOTE=u123456@u123456.your-storagebox.de:backups

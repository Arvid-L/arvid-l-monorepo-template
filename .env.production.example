# Production environment — copy to .env.production and fill in real values.
# .env.production is gitignored and gets scp'd to the server by
# scripts/deploy-remote.sh. It is used both for docker compose variable
# interpolation (--env-file .env.production) and as container environment.

# Project identity (rewritten by the init-project script)
PROJECT_NAME=arvid-l-monorepo-template
ENV_NAME=prod

# Public domain — DNS A record must point at the server before running init-tls.sh
DOMAIN=example.org
LETSENCRYPT_EMAIL=you@example.org

# Allowed CORS origins (comma-separated). The frontend is served same-origin
# through nginx, so this only matters for external API consumers.
CORS_ORIGIN=https://example.org

# Database credentials (DB is only reachable from the compose network + loopback)
DATABASE_NAME=app
DATABASE_USER=app
DATABASE_PASSWORD=change-me

# TLS state — managed by scripts/init-tls.sh, leave these defaults on a fresh
# setup (HTTP-only). init-tls.sh switches them to templates-tls + tls.
NGINX_TEMPLATES=templates-http
COMPOSE_PROFILES=

# Deploy target for scripts/deploy-remote.sh (host may be a ~/.ssh/config alias)
DEPLOY_HOST=my-server
DEPLOY_USER=root
DEPLOY_PATH=/opt/arvid-l-monorepo-template
